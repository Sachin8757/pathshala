<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Admission Form</title>
 <style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a2e; /* Match navbar/footer */
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .form-wrapper {
    background: #22223b;
    padding: 2rem;
    border-radius: 12px;
    max-width: 450px;
    width: 100%;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    animation: fadeIn 0.6s ease-in-out;
    color: #e0e0e0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #ffd700; /* Gold heading */
  }

  label {
    display: block;
    margin-top: 1rem;
    font-weight: 600;
    color: #f5f5f5;
  }

  input {
    width: 100%;
    padding: 10px 12px;
    margin-top: 0.5rem;
    border: 1px solid #444;
    border-radius: 8px;
    font-size: 15px;
    background: #2a2a45;
    color: #fff;
    transition: 0.3s;
  }

  input:focus {
    border-color: #ffd700;
    outline: none;
    box-shadow: 0 0 6px rgba(255, 215, 0, 0.5);
  }

  button {
    width: 100%;
    padding: 12px;
    margin-top: 1.5rem;
    background: #ffd700;
    color: #1a1a2e;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  button:hover {
    background: #e6c200;
    transform: translateY(-2px);
  }

  @media (max-width: 500px) {
    .form-wrapper {
      padding: 1.5rem;
    }
    h2 {
      font-size: 1.5rem;
    }
    input,
    button {
      font-size: 14px;
    }
  }
</style>

</head>

<body>
  
  <div class="form-wrapper">
    <h2>Student Admission Form</h2>
    <form action="/addmition" method="POST">
      <label for="roll_no">roll_no:</label>
      <input type="text" id="roll_no" name="roll_no" required />

      <label for="student_name">Student Name:</label>
      <input type="text" id="student_name" name="student_name" required />

      <label for="join_date">Join Date:</label>
      <input type="date" id="join_date" name="join_date" required />

      <label for="fathers_name">Father's Name:</label>
      <input type="text" id="fathers_name" name="fathers_name" required />

      <label for="fee">Fee:</label>
      <input type="number" id="fee" name="fee" required />

      <label for="password">Password:</label>
      <input type="password" id="password" name="password" required />

      <button type="submit">Submit</button>
    </form>
  </div>
</body>

</html>
