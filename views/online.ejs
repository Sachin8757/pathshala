<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Online Test</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<style>
  /* Base Reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  body {
    background-color: #f4f6f9;
    color: #333;
    line-height: 1.6;
    padding: 10px;
  }

  /* Overlay */
  #userInfoOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
  }

  .overlay-content {
    background: #fff;
    padding: 25px;
    border-radius: 10px;
    width: 90%;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
  }

  /* Test Container */
  .test-container {
    max-width: 900px;
    margin: auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }

  .test-container h1 {
    text-align: center;
    margin-bottom: 15px;
    font-size: 1.6rem;
  }

  /* Timer - make it more visible */
  .timer-box {
    text-align: center;
    font-weight: bold;
    font-size: 1.3rem;
    margin-bottom: 15px;
    color: #0078d4;
    background: #eaf4ff;
    padding: 8px;
    border-radius: 6px;
  }

  /* Question */
  .question h2 {
    font-size: 1.1rem;
    margin-bottom: 12px;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .option-btn {
    padding: 14px;
    background-color: #f1f1f1;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    text-align: center;
    transition: all 0.2s ease-in-out;
  }

  .option-btn:hover {
    background-color: #dcdcdc;
  }

  .option-btn.selected {
    background-color: #0078d4;
    color: white;
    font-weight: bold;
    transform: scale(1.02);
  }

  /* Navigation fixed at bottom for mobile */
  .navigation {
    display: flex;
    justify-content: space-between;
    position: sticky;
    bottom: 0;
    background: white;
    padding: 10px 0;
    border-top: 1px solid #ddd;
    gap: 10px;
  }

  .nav-btn {
    flex: 1;
    padding: 12px;
    font-size: 1rem;
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
  }

  .nav-btn:disabled {
    background-color: #ccc;
  }

  /* Submit Button */
  .submit-btn {
    margin-top: 20px;
    width: 100%;
    padding: 14px;
    background-color: #28a745;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1.2rem;
    font-weight: bold;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .test-container {
      padding: 15px;
      border-radius: 0;
      box-shadow: none;
    }

    .test-container h1 {
      font-size: 1.4rem;
    }

    .timer-box {
      font-size: 1.2rem;
    }

    .option-btn {
      font-size: 1rem;
      padding: 12px;
    }

    .navigation {
      flex-direction: row;
    }
  }

  @media (max-width: 480px) {
    .test-container h1 {
      font-size: 1.2rem;
    }

    .timer-box {
      font-size: 1.1rem;
    }

    .option-btn {
      font-size: 0.95rem;
    }
  }
</style>


</head>
<body>
  <!-- Overlay for Roll No & Name -->
  <div id="userInfoOverlay">
    <div class="overlay-content">
      <h2>Enter Your Details</h2>
      <input type="text" id="rollNo" placeholder="Roll Number">
      <input type="text" id="userName" placeholder="Name">
      <button onclick="startTest()">Start Test</button>
    </div>
  </div>

  <div class="test-container">
    <h1>Online Test</h1>
    <div class="timer-box">Time Left: <span id="timer"></span></div>

    <form id="testForm" action="/submit-test" method="POST" onsubmit="return calculateScore()">
      <!-- Hidden inputs -->
      <input type="hidden" name="rollNo" id="formRollNo">
      <input type="hidden" name="userName" id="formUserName">
      <input type="hidden" name="totalQuestions" id="totalQuestions">
      <input type="hidden" name="correctAnswers" id="correctAnswers">

      <div id="questionContainer">
        <% questions.forEach((q, index) => { %>
          <div class="question hidden" data-index="<%= index %>">
            <h2><%= index + 1 %>. <%= q.text %></h2>
            <div class="options">
              <% q.options.forEach((opt) => { %>
                <button type="button" class="option-btn"
                  onclick="selectOption(<%= index %>, '<%= opt %>', this)">
                  <%= opt %>
                </button>
              <% }) %>
            </div>
            <input type="hidden" name="answer<%= index %>" id="answer<%= index %>">
            <input type="hidden" id="correct<%= index %>" value="<%= q.correctAnswer %>">
          </div>
        <% }) %>
      </div>

      <div class="navigation">
        <button type="button" id="prevBtn" onclick="prevQuestion()" class="nav-btn prev-btn" disabled>Previous</button>
        <button type="button" id="nextBtn" onclick="nextQuestion()" class="nav-btn next-btn">Next</button>
      </div>

      <button type="submit" class="submit-btn hidden" id="submitBtn">Submit Test</button>
    </form>
  </div>

  <script>
    let currentQuestion = 0;
    const questions = document.querySelectorAll(".question");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const submitBtn = document.getElementById("submitBtn");

    function showQuestion(index) {
      questions.forEach((q, i) => q.classList.toggle("hidden", i !== index));
      prevBtn.disabled = index === 0;
      if (index === questions.length - 1) {
        nextBtn.classList.add("hidden");
        submitBtn.classList.remove("hidden");
      } else {
        nextBtn.classList.remove("hidden");
        submitBtn.classList.add("hidden");
      }
    }

    function nextQuestion() {
      if (currentQuestion < questions.length - 1) {
        currentQuestion++;
        showQuestion(currentQuestion);
      }
    }

    function prevQuestion() {
      if (currentQuestion > 0) {
        currentQuestion--;
        showQuestion(currentQuestion);
      }
    }

    function selectOption(qIndex, value, btn) {
      document.getElementById("answer" + qIndex).value = value;
      const buttons = questions[qIndex].querySelectorAll(".option-btn");
      buttons.forEach(b => b.classList.remove("selected"));
      btn.classList.add("selected");
    }

    function startTest() {
      const rollNo = document.getElementById("rollNo").value.trim();
      const name = document.getElementById("userName").value.trim();
      if (!rollNo || !name) {
        alert("Please enter both Roll Number and Name");
        return;
      }
      document.getElementById("formRollNo").value = rollNo;
      document.getElementById("formUserName").value = name;
      document.getElementById("userInfoOverlay").style.display = "none";
      showQuestion(currentQuestion);
      startTimer();
    }

    // Calculate Score
    function calculateScore() {
      let totalQuestions = questions.length;
      let correct = 0;
      questions.forEach((q, index) => {
        let selected = document.getElementById("answer" + index).value;
        let correctAnswer = document.getElementById("correct" + index).value;
        if (selected === correctAnswer) correct++;
      });
      document.getElementById("totalQuestions").value = totalQuestions;
      document.getElementById("correctAnswers").value = correct;
      return true;
    }

    // Timer
    let timeLeft = <%= duration %>;
    const timerEl = document.getElementById("timer");
    function startTimer() {
      function updateTimer() {
        let minutes = Math.floor(timeLeft / 60);
        let seconds = timeLeft % 60;
        timerEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        if (timeLeft <= 0) {
          document.getElementById("testForm").submit();
        } else {
          timeLeft--;
          setTimeout(updateTimer, 1000);
        }
      }
      updateTimer();
    }
  </script>
</body>
</html>
