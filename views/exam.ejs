<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Check Roll Number</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a2e;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .container {
    background: #22223b;
    padding: 30px 25px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    max-width: 400px;
    width: 100%;
    text-align: center;
    color: white;
  }

  h2 {
    margin-bottom: 20px;
    color: #ffd700;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  input {
    width: 100%;
    padding: 10px 12px;
    margin-top: 0.5rem;
    border: 1px solid #444;
    border-radius: 8px;
    font-size: 15px;
    background: #2a2a45;
    color: white;
    transition: 0.3s;
  }

  input:focus {
    border-color: #ffd700;
    outline: none;
    box-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
  }

  .btn-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 10px;
  }

  button {
    padding: 12px;
    font-weight: bold;
    font-size: 16px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .online-btn {
    background: #ffd700;
    color: #1a1a2e;
  }

  .online-btn:hover {
    background: #e6c200;
    transform: translateY(-2px);
    box-shadow: 0 3px 6px rgba(255, 215, 0, 0.3);
  }

  .offline-btn {
    background: #43cea2;
    color: white;
  }

  .offline-btn:hover {
    background: #36b48e;
    transform: translateY(-2px);
    box-shadow: 0 3px 6px rgba(67, 206, 162, 0.3);
  }

  .icon {
    font-size: 40px;
    color: #ffd700;
    margin-bottom: 10px;
  }

  @media (max-width: 480px) {
    .container {
      padding: 20px;
    }

    h2 {
      font-size: 1.4rem;
    }

    input,
    button {
      font-size: 14px;
      padding: 10px;
    }
  }
</style>

</head>
<body>
  <div class="container">
    <div class="icon">
      <i class="fas fa-id-card-alt"></i>
    </div>
    <h2>Check Student Result</h2>

    <!-- We use two separate forms for different routes -->
    <input type="text" id="roll_no_input" name="roll_no" placeholder="Enter Roll Number" required />

    <div class="btn-group">
      <form action="/onlineresult" method="POST" onsubmit="return setRollNumber(this)">
        <input type="hidden" name="roll_no" />
        <button type="submit" class="online-btn"><i class="fas fa-globe"></i> Online Result</button>
      </form>

      <form action="/offlineresult" method="POST" onsubmit="return setRollNumber(this)">
        <input type="hidden" name="roll_no" />
        <button type="submit" class="offline-btn"><i class="fas fa-file-alt"></i> Offline Result</button>
      </form>
    </div>
  </div>

  <script>
    function setRollNumber(form) {
      const rollInput = document.getElementById("roll_no_input");
      if (!rollInput.value.trim()) {
        alert("Please enter Roll Number");
        return false;
      }
      form.querySelector("input[name='roll_no']").value = rollInput.value.trim();
      return true;
    }
  </script>
</body>
</html>
