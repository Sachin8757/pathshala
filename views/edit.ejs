<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Student</title>
<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a2e; /* Match navbar/footer */
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .container {
    background: #22223b; /* Dark card background */
    max-width: 500px;
    width: 100%;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    color: #e0e0e0;
  }

  h2 {
    text-align: center;
    margin-bottom: 20px;
    color: #ffd700; /* Gold heading */
  }

  form {
    display: flex;
    flex-direction: column;
  }

  label {
    font-weight: 600;
    margin-top: 10px;
    color: #f5f5f5;
  }

  input {
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #444;
    border-radius: 8px;
    font-size: 16px;
    background: #2a2a45;
    color: #fff;
    transition: 0.3s;
  }

  input:focus {
    border-color: #ffd700;
    outline: none;
    box-shadow: 0 0 6px rgba(255, 215, 0, 0.5);
  }

  button {
    margin-top: 20px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    color: #1a1a2e;
    background: #ffd700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
  }

  button:hover {
    background: #e6c200;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
  }

  @media (max-width: 500px) {
    .container {
      padding: 20px;
    }

    h2 {
      font-size: 1.5rem;
    }

    input,
    button {
      font-size: 14px;
    }
  }
</style>

</head>

<body>

  <div class="container">
    <h2>Edit Student Information</h2>
    <form action="/edit/<%= student._id %>" method="POST">
      <label for="roll_no">roll_no</label>
      <input type="text" id="roll_no" name="roll_no" value="<%= student.roll_no %>" required />

      <label for="student_name">Student Name</label>
      <input type="text" id="student_name" name="student_name" value="<%= student.student_name %>" required />

      <label for="join_date">Join Date</label>
      <input type="date" id="join_date" name="join_date" value="<%= student.join_date.toISOString().split('T')[0] %>"
        required />

      <label for="fathers_name">Father's Name</label>
      <input type="text" id="fathers_name" name="fathers_name" value="<%= student.fathers_name %>" required />

      <label for="fee">Fee (₹)</label>
      <input type="number" id="fee" name="fee" value="<%= student.fee %>" required />

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Password" required />

      <button type="submit">Update Student</button>
    </form>
  </div>

</body>

</html>